@page "/calculator-api"
@rendermode InteractiveAuto
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using RoadRules.Shared
@inject HttpClient Http

@* The Vue calculator (roadrules-vue/src/components/Calculator.vue) converted to Blazor.
   Same API underneath; the behaviour is pinned by ParityTests. Differences from the
   Vue page, kept or changed on purpose, are listed in NOTES.md (step 13d). *@

<PageTitle>Weight calculator (API)</PageTitle>

<div class="rr-page-header">
    <div>
        <div class="rr-eyebrow">Tools</div>
        <h1 class="rr-title">Weight calculator (via API)</h1>
        <p class="rr-subtitle">The same calculator, running against the API. It calls <code>/api/calculate</code> for the limit in effect today.</p>
    </div>
</div>

<div class="rr-card rr-card-body rr-fade" style="max-width: 32rem">
    @if (loadError is not null)
    {
        <div class="rr-alert-error mb-3" role="alert">@loadError</div>
    }

    <EditForm Model="input" OnValidSubmit="Calculate" OnInvalidSubmit="ClearResult" FormName="calculator-api">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label" for="api-jurisdiction">Jurisdiction</label>
            <InputSelect id="api-jurisdiction" class="form-select" @bind-Value="input.Code">
                <option value="">Select...</option>
                @foreach (var j in jurisdictions)
                {
                    <option @key="j.Code" value="@j.Code">@j.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label" for="api-axles">Axles in the group</label>
            <InputNumber id="api-axles" class="form-control" @bind-Value="input.Axles" min="1" max="3"
                         DisplayName="Axles" ParsingErrorMessage="Axles must be a whole number." />
            <ValidationMessage For="() => input.Axles" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@(!CanSubmit)">Calculate</button>
    </EditForm>

    @if (result is not null)
    {
        <p class="mt-3 mb-0">
            Maximum for a @result.AxleGroup.ToLower() group in @result.JurisdictionCode:
            <strong>@result.MaxKg.ToString("N0") kg</strong>
        </p>
    }
    @if (error is not null)
    {
        <p class="mt-3 mb-0 text-danger" role="alert">@error</p>
    }
</div>

@code {
    private record JurisdictionDto(string Code, string Name);
    private record ApiError(string Message);

    private List<JurisdictionDto> jurisdictions = new();
    private Input input = new();
    private WeightResult? result;
    private string? error;
    private string? loadError;

    private bool CanSubmit => input.Code != "" && input.Axles is >= 1 and <= 3;

    protected override async Task OnInitializedAsync()
    {
        // Changed on purpose: the Vue page left an empty dropdown and said nothing
        // when this call failed.
        try
        {
            jurisdictions = await Http.GetFromJsonAsync<List<JurisdictionDto>>("api/jurisdictions") ?? new();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            loadError = "Could not load the jurisdictions. Reload the page to try again.";
        }
    }

    // Changed on purpose: with "" or "2.5" in the axle box the bound value keeps its
    // last good number, so the button stays enabled and the submit is invalid.
    // Without this the previous result stays on screen next to the validation message.
    private void ClearResult()
    {
        result = null;
        error = null;
    }

    private async Task Calculate()
    {
        ClearResult();
        try
        {
            var response = await Http.GetAsync(
                $"api/calculate?code={Uri.EscapeDataString(input.Code)}&axles={input.Axles}");
            if (response.IsSuccessStatusCode)
            {
                result = await response.Content.ReadFromJsonAsync<WeightResult>();
            }
            else
            {
                // Like the Vue page: the API's message when the body has one, a fallback when not.
                error = await ReadMessageAsync(response) ?? $"Request failed ({(int)response.StatusCode})";
            }
        }
        catch (HttpRequestException)
        {
            error = "Request failed";
        }
    }

    // A 404/400 from the API has { "message": ... }; anything else (an HTML error page,
    // an empty body) must not throw out of the event handler.
    private static async Task<string?> ReadMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<ApiError>();
            return string.IsNullOrWhiteSpace(body?.Message) ? null : body.Message;
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or NotSupportedException)
        {
            return null;
        }
    }

    private class Input
    {
        [Required] public string Code { get; set; } = "";
        [Range(1, 3, ErrorMessage = "Axles must be between 1 and 3.")] public int Axles { get; set; } = 1;
    }
}
